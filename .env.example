# Template for .env. `voice-agent init` creates a private .env from it with fresh local secrets.

# --- Step 1: talk to the agent in a browser (ElevenLabs only) ---
ELEVENLABS_API_KEY=
# Empty until `voice-agent agent apply --yes --save-agent-id` creates the agent and writes it here.
ELEVENLABS_AGENT_ID=

# Operator console and controls (/operator). Empty = operator routes return 404. At least 32 characters.
OPERATOR_TOKEN=
# Key for caller identities in the booking store (HMAC). Required before any call, including
# browser tests. Falls back to WHATSAPP_WEBHOOK_SECRET; keep it separate so rotating the webhook
# secret does not orphan bookings.
CALLER_KEY_SECRET=

# --- Step 2: answer WhatsApp calls through Kapso ---
# Kapso project API key.
KAPSO_API_KEY=
# Meta's numeric phone number ID, not the display number.
WHATSAPP_PHONE_NUMBER_ID=
# Same value you give Kapso as the Meta webhook's secret_key (`voice-agent kapso webhook` sends it).
# Verifies X-Webhook-Signature.
WHATSAPP_WEBHOOK_SECRET=
META_GRAPH_VERSION=v24.0

# Media networking. JSON list of ICE servers. See docs/deploy.md.
# Example with TURN: [{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
ICE_SERVERS_JSON=[]

# Outbound calls cost money (Meta per-minute rates) and ring real phones. Off by default.
ENABLE_OUTBOUND=0

# --- Limits ---
MAX_SESSION_SECONDS=200
MAX_CONCURRENT_CALLS=1

# --- Optional local capture (caller/agent WAV + provider turn text, private files). ---
# Turning it on also makes the greeting say the call is recorded.
LOCAL_CAPTURE=0
# Local copies (captures and `artifacts fetch` downloads) are deleted after this many days:
# at server start, hourly while it runs, and by `voice-agent artifacts prune`. Provider copies
# follow the provider's own retention (agent.toml privacy.retention_days).
CAPTURE_RETENTION_DAYS=7
CAPTURE_MAX_COUNT=20

# --- Misc ---
# Private state (bookings, captures). The server makes this directory 0700 and must own it.
# DATA_DIR=./data
# AGENT_CONFIG_PATH=./agent/agent.toml
# Comma-separated Host header allowlist, e.g. voice.example.com,127.0.0.1:8080
ALLOWED_HOSTS=
# Development only: ws://127.0.0.1:8765 from `voice-agent dev fake-agent`. Loopback addresses only.
DEV_AGENT_WS_URL=
